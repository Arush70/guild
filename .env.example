# Copy to .env and `source` it, or export in your shell. Only set what your profile needs.
# guild never reads .env itself — use direnv, `set -a; source .env; set +a`, or your shell.

# --- free profile (all optional) ---
OLLAMA_HOST=http://localhost:11434
GROQ_API_KEY=
GEMINI_API_KEY=

# --- lite profile ---
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=

# --- pro profile ---
OPENAI_API_KEY=

# --- other OpenAI-compatible providers ---
OPENROUTER_API_KEY=
MISTRAL_API_KEY=
OMNIROUTE_HOST=http://localhost:20128
LITELLM_HOST=http://localhost:4000
CUSTOM_OPENAI_BASE_URL=
CUSTOM_OPENAI_API_KEY=
