{
  "name": "codeguild-vscode",
  "displayName": "Codeguild",
  "description": "Run codeguild \u2014 a budget-aware multi-agent coding team \u2014 from the VS Code side bar: plan, run tasks, watch the team work, review and merge branches, and pair-program in a chat that asks before every change.",
  "version": "0.3.0",
  "publisher": "arush70",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arush70/guild"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agents",
    "llm",
    "ollama",
    "code review",
    "multi-agent"
  ],
  "main": "./extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false,
      "description": "Codeguild starts the codeguild program found in the opened folder (its .venv) and runs that folder's configured test command."
    },
    "virtualWorkspaces": false
  },
  "activationEvents": [
    "workspaceContains:.codeguild/config.yaml"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js test/e2e.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codeguild",
          "title": "Codeguild",
          "icon": "media/codeguild.svg"
        }
      ]
    },
    "views": {
      "codeguild": [
        {
          "id": "codeguild.plan",
          "name": "Plan"
        },
        {
          "id": "codeguild.chat",
          "name": "Chat & Activity",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codeguild.plan",
        "contents": "Open a folder to use codeguild.",
        "when": "codeguild.state == 'noFolder'"
      },
      {
        "view": "codeguild.plan",
        "contents": "Codeguild is not set up in this folder yet.\n[Set up codeguild here](command:codeguild.init)\nThe wizard detects your hardware, API keys and test command, then writes .codeguild/config.yaml.\n[Start without the wizard](command:codeguild.start)",
        "when": "codeguild.state == 'uninitialised'"
      },
      {
        "view": "codeguild.plan",
        "contents": "Codeguild is not running.\n[Start codeguild](command:codeguild.start)",
        "when": "codeguild.state == 'stopped'"
      },
      {
        "view": "codeguild.plan",
        "contents": "Starting codeguild\u2026",
        "when": "codeguild.state == 'starting'"
      },
      {
        "view": "codeguild.plan",
        "contents": "Codeguild could not start. Usually the `codeguild` command is not on VS Code's PATH: set the full path in the settings (for example C:\\\\path\\\\to\\\\.venv\\\\Scripts\\\\codeguild.exe).\n[Open settings](command:codeguild.openSettings)\n[Try again](command:codeguild.start)\n[Show log](command:codeguild.showLog)",
        "when": "codeguild.state == 'error'"
      },
      {
        "view": "codeguild.plan",
        "contents": "No plan yet. Describe what you want built and the Lead will break it into tasks.\n[Create a plan](command:codeguild.plan)",
        "when": "codeguild.state == 'running' && !codeguild.hasPlan"
      }
    ],
    "commands": [
      {
        "command": "codeguild.start",
        "title": "Start",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.stop",
        "title": "Stop Server",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.restart",
        "title": "Restart Server",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.cancel",
        "title": "Stop Current Job",
        "category": "Codeguild",
        "icon": "$(debug-stop)"
      },
      {
        "command": "codeguild.init",
        "title": "Set Up in This Folder (codeguild init)",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.plan",
        "title": "New Plan\u2026",
        "category": "Codeguild",
        "icon": "$(add)"
      },
      {
        "command": "codeguild.revisePlan",
        "title": "Revise Plan\u2026",
        "category": "Codeguild",
        "icon": "$(edit)"
      },
      {
        "command": "codeguild.runNext",
        "title": "Run Next Task",
        "category": "Codeguild",
        "icon": "$(play)"
      },
      {
        "command": "codeguild.runAll",
        "title": "Run All Tasks",
        "category": "Codeguild",
        "icon": "$(run-all)"
      },
      {
        "command": "codeguild.refresh",
        "title": "Refresh",
        "category": "Codeguild",
        "icon": "$(refresh)"
      },
      {
        "command": "codeguild.runTask",
        "title": "Run Task",
        "category": "Codeguild",
        "icon": "$(play)"
      },
      {
        "command": "codeguild.diffTask",
        "title": "Review Changes",
        "category": "Codeguild",
        "icon": "$(diff)"
      },
      {
        "command": "codeguild.mergeTask",
        "title": "Merge Branch",
        "category": "Codeguild",
        "icon": "$(git-merge)"
      },
      {
        "command": "codeguild.discardTask",
        "title": "Discard Branch",
        "category": "Codeguild",
        "icon": "$(trash)"
      },
      {
        "command": "codeguild.editTask",
        "title": "Edit Task\u2026",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.deleteTask",
        "title": "Delete Task",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.markTask",
        "title": "Set Task Status\u2026",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.setProfile",
        "title": "Switch Profile\u2026",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.doctor",
        "title": "Doctor (Check Models)",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.showRuns",
        "title": "Show Run Trace\u2026",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.showLog",
        "title": "Show Log",
        "category": "Codeguild",
        "icon": "$(output)"
      },
      {
        "command": "codeguild.openDashboard",
        "title": "Open Dashboard in Browser",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.openSettings",
        "title": "Open Settings",
        "category": "Codeguild"
      },
      {
        "command": "codeguild.clearChat",
        "title": "Clear Chat",
        "category": "Codeguild",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codeguild.plan",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "navigation@1"
        },
        {
          "command": "codeguild.runNext",
          "when": "view == codeguild.plan && codeguild.hasPlan && !codeguild.busy",
          "group": "navigation@2"
        },
        {
          "command": "codeguild.runAll",
          "when": "view == codeguild.plan && codeguild.hasPlan && !codeguild.busy",
          "group": "navigation@3"
        },
        {
          "command": "codeguild.cancel",
          "when": "view == codeguild.plan && codeguild.busy",
          "group": "navigation@2"
        },
        {
          "command": "codeguild.refresh",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "navigation@9"
        },
        {
          "command": "codeguild.revisePlan",
          "when": "view == codeguild.plan && codeguild.hasPlan",
          "group": "1_plan@1"
        },
        {
          "command": "codeguild.setProfile",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "2_cfg@1"
        },
        {
          "command": "codeguild.doctor",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "2_cfg@2"
        },
        {
          "command": "codeguild.showRuns",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "3_more@1"
        },
        {
          "command": "codeguild.openDashboard",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "3_more@2"
        },
        {
          "command": "codeguild.stop",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "3_more@3"
        },
        {
          "command": "codeguild.showLog",
          "when": "view == codeguild.chat",
          "group": "navigation@1"
        },
        {
          "command": "codeguild.clearChat",
          "when": "view == codeguild.chat",
          "group": "navigation@2"
        },
        {
          "command": "codeguild.restart",
          "when": "view == codeguild.plan && codeguild.state == 'running'",
          "group": "3_more@4"
        },
        {
          "command": "codeguild.cancel",
          "when": "view == codeguild.chat && codeguild.busy",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "codeguild.runTask",
          "when": "view == codeguild.plan && viewItem =~ /^task/ && !(viewItem =~ / done/) && !codeguild.busy",
          "group": "inline@1"
        },
        {
          "command": "codeguild.diffTask",
          "when": "view == codeguild.plan && viewItem =~ / hasBranch/",
          "group": "inline@2"
        },
        {
          "command": "codeguild.mergeTask",
          "when": "view == codeguild.plan && viewItem =~ / hasBranch/ && !codeguild.busy",
          "group": "inline@3"
        },
        {
          "command": "codeguild.runTask",
          "when": "view == codeguild.plan && viewItem =~ /^task/ && !codeguild.busy",
          "group": "1_run@1"
        },
        {
          "command": "codeguild.diffTask",
          "when": "view == codeguild.plan && viewItem =~ / hasBranch/",
          "group": "2_branch@1"
        },
        {
          "command": "codeguild.mergeTask",
          "when": "view == codeguild.plan && viewItem =~ / hasBranch/ && !codeguild.busy",
          "group": "2_branch@2"
        },
        {
          "command": "codeguild.discardTask",
          "when": "view == codeguild.plan && viewItem =~ / hasBranch/ && !codeguild.busy",
          "group": "2_branch@3"
        },
        {
          "command": "codeguild.editTask",
          "when": "view == codeguild.plan && viewItem =~ /^task/ && !codeguild.busy",
          "group": "3_edit@1"
        },
        {
          "command": "codeguild.markTask",
          "when": "view == codeguild.plan && viewItem =~ /^task/ && !codeguild.busy",
          "group": "3_edit@2"
        },
        {
          "command": "codeguild.deleteTask",
          "when": "view == codeguild.plan && viewItem =~ /^task/ && !codeguild.busy",
          "group": "3_edit@3"
        }
      ],
      "commandPalette": [
        {
          "command": "codeguild.runTask",
          "when": "false"
        },
        {
          "command": "codeguild.diffTask",
          "when": "false"
        },
        {
          "command": "codeguild.mergeTask",
          "when": "false"
        },
        {
          "command": "codeguild.discardTask",
          "when": "false"
        },
        {
          "command": "codeguild.editTask",
          "when": "false"
        },
        {
          "command": "codeguild.deleteTask",
          "when": "false"
        },
        {
          "command": "codeguild.markTask",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Codeguild",
      "properties": {
        "codeguild.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "How to launch codeguild, e.g. `C:\\path\\to\\.venv\\Scripts\\codeguild.exe` or `py -m codeguild.cli`. Empty: try the workspace's `.venv`, the selected Python interpreter, then `codeguild` on PATH.",
          "scope": "machine-overridable"
        },
        "codeguild.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start codeguild automatically when the opened folder already has .codeguild/config.yaml."
        },
        "codeguild.port": {
          "type": "integer",
          "default": 0,
          "description": "Port for the local codeguild server. 0 picks a free port."
        },
        "codeguild.profile": {
          "type": "string",
          "default": "",
          "description": "Profile to use for jobs started from VS Code (free / lite / pro / your own). Empty: the project's configured profile."
        },
        "codeguild.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a task finishes or a job fails."
        }
      }
    }
  }
}
