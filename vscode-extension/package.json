{
  "name": "guild-vscode",
  "displayName": "Guild",
  "description": "Run guild \u2014 a budget-aware multi-agent coding team \u2014 from the VS Code side bar: plan, run tasks, watch the team work, review and merge branches, and pair-program in a chat that asks before every change.",
  "version": "0.2.0",
  "publisher": "arush70",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Arush70/guild"
  },
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "keywords": [
    "agents",
    "llm",
    "ollama",
    "code review",
    "multi-agent"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "workspaceContains:.guild/config.yaml"
  ],
  "scripts": {
    "test": "node --test test/unit.test.js test/e2e.test.js",
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "guild",
          "title": "Guild",
          "icon": "media/guild.svg"
        }
      ]
    },
    "views": {
      "guild": [
        {
          "id": "guild.plan",
          "name": "Plan"
        },
        {
          "id": "guild.chat",
          "name": "Chat & Activity",
          "type": "webview"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "guild.plan",
        "contents": "Open a folder to use guild.",
        "when": "guild.state == 'noFolder'"
      },
      {
        "view": "guild.plan",
        "contents": "Guild is not set up in this folder yet.\n[Set up guild here](command:guild.init)\nThe wizard detects your hardware, API keys and test command, then writes .guild/config.yaml.\n[Start without the wizard](command:guild.start)",
        "when": "guild.state == 'uninitialised'"
      },
      {
        "view": "guild.plan",
        "contents": "Guild is not running.\n[Start guild](command:guild.start)",
        "when": "guild.state == 'stopped'"
      },
      {
        "view": "guild.plan",
        "contents": "Starting guild\u2026",
        "when": "guild.state == 'starting'"
      },
      {
        "view": "guild.plan",
        "contents": "Guild could not start. Usually the `guild` command is not on VS Code's PATH: set the full path in the settings (for example C:\\\\path\\\\to\\\\.venv\\\\Scripts\\\\guild.exe).\n[Open settings](command:guild.openSettings)\n[Try again](command:guild.start)\n[Show log](command:guild.showLog)",
        "when": "guild.state == 'error'"
      },
      {
        "view": "guild.plan",
        "contents": "No plan yet. Describe what you want built and the Lead will break it into tasks.\n[Create a plan](command:guild.plan)",
        "when": "guild.state == 'running' && !guild.hasPlan"
      }
    ],
    "commands": [
      {
        "command": "guild.start",
        "title": "Start",
        "category": "Guild"
      },
      {
        "command": "guild.stop",
        "title": "Stop Server",
        "category": "Guild"
      },
      {
        "command": "guild.restart",
        "title": "Restart Server",
        "category": "Guild"
      },
      {
        "command": "guild.cancel",
        "title": "Stop Current Job",
        "category": "Guild",
        "icon": "$(debug-stop)"
      },
      {
        "command": "guild.init",
        "title": "Set Up in This Folder (guild init)",
        "category": "Guild"
      },
      {
        "command": "guild.plan",
        "title": "New Plan\u2026",
        "category": "Guild",
        "icon": "$(add)"
      },
      {
        "command": "guild.revisePlan",
        "title": "Revise Plan\u2026",
        "category": "Guild",
        "icon": "$(edit)"
      },
      {
        "command": "guild.runNext",
        "title": "Run Next Task",
        "category": "Guild",
        "icon": "$(play)"
      },
      {
        "command": "guild.runAll",
        "title": "Run All Tasks",
        "category": "Guild",
        "icon": "$(run-all)"
      },
      {
        "command": "guild.refresh",
        "title": "Refresh",
        "category": "Guild",
        "icon": "$(refresh)"
      },
      {
        "command": "guild.runTask",
        "title": "Run Task",
        "category": "Guild",
        "icon": "$(play)"
      },
      {
        "command": "guild.diffTask",
        "title": "Review Changes",
        "category": "Guild",
        "icon": "$(diff)"
      },
      {
        "command": "guild.mergeTask",
        "title": "Merge Branch",
        "category": "Guild",
        "icon": "$(git-merge)"
      },
      {
        "command": "guild.discardTask",
        "title": "Discard Branch",
        "category": "Guild",
        "icon": "$(trash)"
      },
      {
        "command": "guild.editTask",
        "title": "Edit Task\u2026",
        "category": "Guild"
      },
      {
        "command": "guild.deleteTask",
        "title": "Delete Task",
        "category": "Guild"
      },
      {
        "command": "guild.markTask",
        "title": "Set Task Status\u2026",
        "category": "Guild"
      },
      {
        "command": "guild.setProfile",
        "title": "Switch Profile\u2026",
        "category": "Guild"
      },
      {
        "command": "guild.doctor",
        "title": "Doctor (Check Models)",
        "category": "Guild"
      },
      {
        "command": "guild.showRuns",
        "title": "Show Run Trace\u2026",
        "category": "Guild"
      },
      {
        "command": "guild.showLog",
        "title": "Show Log",
        "category": "Guild",
        "icon": "$(output)"
      },
      {
        "command": "guild.openDashboard",
        "title": "Open Dashboard in Browser",
        "category": "Guild"
      },
      {
        "command": "guild.openSettings",
        "title": "Open Settings",
        "category": "Guild"
      },
      {
        "command": "guild.clearChat",
        "title": "Clear Chat",
        "category": "Guild",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "guild.plan",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "navigation@1"
        },
        {
          "command": "guild.runNext",
          "when": "view == guild.plan && guild.hasPlan && !guild.busy",
          "group": "navigation@2"
        },
        {
          "command": "guild.runAll",
          "when": "view == guild.plan && guild.hasPlan && !guild.busy",
          "group": "navigation@3"
        },
        {
          "command": "guild.cancel",
          "when": "view == guild.plan && guild.busy",
          "group": "navigation@2"
        },
        {
          "command": "guild.refresh",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "navigation@9"
        },
        {
          "command": "guild.revisePlan",
          "when": "view == guild.plan && guild.hasPlan",
          "group": "1_plan@1"
        },
        {
          "command": "guild.setProfile",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "2_cfg@1"
        },
        {
          "command": "guild.doctor",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "2_cfg@2"
        },
        {
          "command": "guild.showRuns",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "3_more@1"
        },
        {
          "command": "guild.openDashboard",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "3_more@2"
        },
        {
          "command": "guild.stop",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "3_more@3"
        },
        {
          "command": "guild.showLog",
          "when": "view == guild.chat",
          "group": "navigation@1"
        },
        {
          "command": "guild.clearChat",
          "when": "view == guild.chat",
          "group": "navigation@2"
        },
        {
          "command": "guild.restart",
          "when": "view == guild.plan && guild.state == 'running'",
          "group": "3_more@4"
        },
        {
          "command": "guild.cancel",
          "when": "view == guild.chat && guild.busy",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "guild.runTask",
          "when": "view == guild.plan && viewItem =~ /^task/ && !(viewItem =~ / done/) && !guild.busy",
          "group": "inline@1"
        },
        {
          "command": "guild.diffTask",
          "when": "view == guild.plan && viewItem =~ / hasBranch/",
          "group": "inline@2"
        },
        {
          "command": "guild.mergeTask",
          "when": "view == guild.plan && viewItem =~ / hasBranch/ && !guild.busy",
          "group": "inline@3"
        },
        {
          "command": "guild.runTask",
          "when": "view == guild.plan && viewItem =~ /^task/ && !guild.busy",
          "group": "1_run@1"
        },
        {
          "command": "guild.diffTask",
          "when": "view == guild.plan && viewItem =~ / hasBranch/",
          "group": "2_branch@1"
        },
        {
          "command": "guild.mergeTask",
          "when": "view == guild.plan && viewItem =~ / hasBranch/ && !guild.busy",
          "group": "2_branch@2"
        },
        {
          "command": "guild.discardTask",
          "when": "view == guild.plan && viewItem =~ / hasBranch/ && !guild.busy",
          "group": "2_branch@3"
        },
        {
          "command": "guild.editTask",
          "when": "view == guild.plan && viewItem =~ /^task/ && !guild.busy",
          "group": "3_edit@1"
        },
        {
          "command": "guild.markTask",
          "when": "view == guild.plan && viewItem =~ /^task/ && !guild.busy",
          "group": "3_edit@2"
        },
        {
          "command": "guild.deleteTask",
          "when": "view == guild.plan && viewItem =~ /^task/ && !guild.busy",
          "group": "3_edit@3"
        }
      ],
      "commandPalette": [
        {
          "command": "guild.runTask",
          "when": "false"
        },
        {
          "command": "guild.diffTask",
          "when": "false"
        },
        {
          "command": "guild.mergeTask",
          "when": "false"
        },
        {
          "command": "guild.discardTask",
          "when": "false"
        },
        {
          "command": "guild.editTask",
          "when": "false"
        },
        {
          "command": "guild.deleteTask",
          "when": "false"
        },
        {
          "command": "guild.markTask",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Guild",
      "properties": {
        "guild.command": {
          "type": "string",
          "default": "",
          "markdownDescription": "How to launch guild, e.g. `C:\\path\\to\\.venv\\Scripts\\guild.exe` or `py -m guild.cli`. Empty: try the workspace's `.venv`, the selected Python interpreter, then `guild` on PATH.",
          "scope": "machine-overridable"
        },
        "guild.autoStart": {
          "type": "boolean",
          "default": true,
          "description": "Start guild automatically when the opened folder already has .guild/config.yaml."
        },
        "guild.port": {
          "type": "integer",
          "default": 0,
          "description": "Port for the local guild server. 0 picks a free port."
        },
        "guild.profile": {
          "type": "string",
          "default": "",
          "description": "Profile to use for jobs started from VS Code (free / lite / pro / your own). Empty: the project's configured profile."
        },
        "guild.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Show a notification when a task finishes or a job fails."
        }
      }
    }
  }
}
